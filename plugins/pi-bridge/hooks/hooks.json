{
  "description": "审查 Claude 同意 pi 权限确认的命令，高风险或经 Sonnet 复核认为危险时弹窗请用户确认",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(pi-bridge answer *)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/confirm-guard.ts\"",
            "timeout": 90,
            "statusMessage": "pi-bridge 审查权限确认"
          }
        ]
      }
    ]
  }
}
